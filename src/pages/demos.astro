const demos = [
  {
    id: "sabor-bolivia",
    title: "Sabor de Bolivia",
    description: "Restaurante Gourmet Boliviano",
    content: saborBoliviaHTML,
    thumbnail: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=600"
  }, {
    id: "sabor-bolivia",
    title: "Sabor de Bolivia",
    description: "Restaurante Gourmet Boliviano",
    content: sabornuevoHTML,
    thumbnail: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=600"
  }
];
---

<MainLayout title="Demos - Miracode">
  <div class="p-10 min-h-screen relative z-10">
    <h1 class="text-3xl font-bold text-white mb-8 text-center">Catálogo de Soluciones</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {demos.map(demo => (
        <div 
          class="bg-[#1a1a1a] rounded-xl overflow-hidden cursor-pointer hover:ring-2 hover:ring-green-400 transition-all group"
          onclick={`
            document.getElementById('modal-${demo.id}').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            document.documentElement.classList.add('modal-open');
          `}
        >
          <img src={demo.thumbnail} alt={demo.title} class="w-full h-48 object-cover opacity-80 group-hover:opacity-100" />
          <div class="p-4">
            <h3 class="text-white font-bold text-xl">{demo.title}</h3>
            <p class="text-gray-400 text-sm mt-1">{demo.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  {/* MODALES DINÁMICOS - AISLAMIENTO TOTAL */}
  {demos.map(demo => (
    <div 
      id={`modal-${demo.id}`} 
      class="hidden fixed inset-0 z-[10000] bg-black flex flex-col w-screen h-screen overflow-hidden"
      style="top:0; left:0; right:0; bottom:0;"
    >
      <div class="p-4 flex justify-between items-center bg-[#111] border-b border-white/10 shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-green-500 animate-pulse"></div>
            <h2 class="text-white font-bold">{demo.title} - Vista Previa</h2>
        </div>
        <button 
          class="bg-red-500 hover:bg-red-600 text-white px-5 py-2 rounded-full font-bold transition-all shadow-xl"
          onclick={`
            document.getElementById('modal-${demo.id}').classList.add('hidden');
            document.body.style.overflow = 'auto';
            document.documentElement.classList.remove('modal-open');
          `}
        >
          Cerrar Demo
        </button>
      </div>

      <div class="flex-1 w-full h-full bg-white overflow-hidden relative">
         <DemoScreen htmlContent={demo.content} />
      </div>
    </div>
  ))}
</MainLayout>

<style is:global>
  /* Esta es la parte clave: 
     Cuando el modal está abierto, forzamos a que el footer 
     y el contenido original de Miracode no interfieran.
  */
  html.modal-open #footer, 
  html.modal-open footer {
    display: none !important;
  }

  html.modal-open main {
    visibility: hidden;
  }
  
  /* Aseguramos que el modal siga siendo visible aunque el main se oculte */
  [id^="modal-"] {
    visibility: visible !important;
  }
</style>