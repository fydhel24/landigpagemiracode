---
import MainLayout from "../../layouts/MainLayout.astro";
import Section from "../../components/sections/Section.astro";
import { services } from "../../data/services";
import { Image } from "astro:assets";
import Contact from "../../components/sections/Contact.astro";
import Process from "../../components/sections/Process.astro";

export async function getStaticPaths() {
    return services.map((service) => ({
        params: { id: service.id },
        props: { service },
    }));
}

const { id } = Astro.params;
const service = services.find((s) => s.id === id);

if (!service) {
    return Astro.redirect("/404");
}

const { titleTop, titleBottom, description, features, heroImg, alt } = service;
---

<MainLayout
    title={`${titleTop} ${titleBottom} - Positivus`}
    description={description}
>
    <!-- Full Screen Hero Banner -->
    <div class="relative w-full h-[60vh] md:h-[80vh] overflow-hidden bg-gray-100 dark:bg-gray-950">
        <div class="absolute inset-0 flex items-center justify-center p-4 md:p-12">
            <div id="hero-image-container" class="relative w-full h-full max-w-7xl mx-auto rounded-[40px] overflow-hidden opacity-0 translate-y-20 shadow-[0_50px_100px_-20px_rgba(0,0,0,0.5)] border border-white/20">
                <Image
                    src={heroImg}
                    alt={alt}
                    class="w-full h-full object-cover object-top scale-110"
                    id="hero-image"
                    quality="high"
                    loading="eager"
                />
                <!-- Premium Overlay Gradient -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
            </div>
        </div>
        
        <!-- Hero Content Overlay -->
        <div class="absolute inset-0 flex flex-col justify-end p-8 md:p-24 pointer-events-none">
            <div class="max-w-7xl mx-auto w-full">
                <div id="hero-text" class="opacity-0 translate-y-10">
                    <span class="inline-block bg-lime text-black px-6 py-2 rounded-full text-xs font-black uppercase tracking-[0.2em] mb-6 shadow-xl shadow-lime/20">
                        Demo de Sistema v1.0
                    </span>
                    <h1 class="text-5xl md:text-9xl font-black text-white leading-none tracking-tighter drop-shadow-2xl">
                        {titleTop}<br/>
                        <span class="text-lime">{titleBottom}</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>

    <script>
        import { gsap } from "gsap";
        
        window.addEventListener('DOMContentLoaded', () => {
            const tl = gsap.timeline({ defaults: { ease: "power4.out" } });
            
            tl.to("#hero-image-container", {
                opacity: 1,
                y: 0,
                duration: 1.5,
            })
            .to("#hero-image", {
                scale: 1,
                duration: 2,
            }, "-=1.2")
            .to("#hero-text", {
                opacity: 1,
                y: 0,
                duration: 1,
                stagger: 0.2
            }, "-=1.5");
        });
    </script>

    <Section id="service-detail">
        <div class="py-16 md:py-24">
            <a
                href="/#services"
                class="group inline-flex items-center gap-3 text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white mb-16 transition-all duration-300 transform hover:-translate-x-1"
            >
                <div class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center group-hover:bg-black group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-black transition-all">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-arrow-left"
                        ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"
                        ></path></svg
                    >
                </div>
                <span class="font-bold uppercase tracking-widest text-sm">Regresar</span>
            </a>

            <div class="max-w-6xl mx-auto">
                <div class="grid lg:grid-cols-12 gap-16 mb-24">
                    <div class="lg:col-span-12">
                         <p class="text-2xl md:text-4xl text-gray-700 dark:text-gray-200 leading-[1.3] font-medium max-w-4xl">
                            {description}
                        </p>
                    </div>
                </div>

                <div class="grid lg:grid-cols-3 gap-8 mb-32">
                    <div
                        class="lg:col-span-2 glass-card p-10 md:p-14 rounded-[45px] border border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50 backdrop-blur-sm relative overflow-hidden"
                    >
                        <div class="absolute top-0 right-0 p-10 opacity-10">
                            <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M12 2L2 7L12 12L22 7L12 2Z" />
                                <path d="M2 17L12 22L22 17" />
                                <path d="M2 12L12 17L22 12" />
                            </svg>
                        </div>
                        <h3 class="text-3xl font-bold mb-10 flex items-center gap-4">
                            <span class="w-2 h-10 bg-lime rounded-full"></span>
                            Características Clave
                        </h3>
                        <div class="grid md:grid-cols-2 gap-y-8 gap-x-12">
                            {
                                features.map((feature) => (
                                    <div class="flex items-start gap-4 group">
                                        <div class="mt-1 bg-lime text-black rounded-xl p-2 flex-shrink-0 shadow-lg shadow-lime/20 group-hover:scale-110 transition-transform">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="18"
                                                height="18"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="3"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <polyline points="20 6 9 17 4 12" />
                                            </svg>
                                        </div>
                                        <span class="text-xl font-semibold text-gray-800 dark:text-gray-100 uppercase tracking-tight leading-tight pt-1">
                                            {feature}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <div
                        class="flex flex-col justify-between p-10 md:p-14 bg-black text-white rounded-[45px] shadow-2xl relative overflow-hidden group"
                    >
                        <div class="absolute -bottom-20 -right-20 w-64 h-64 bg-lime/20 rounded-full blur-[80px] group-hover:bg-lime/30 transition-all duration-700"></div>
                        
                        <div>
                            <h3 class="text-4xl font-black mb-6 leading-tight">
                                Impulse su<br/><span class="text-lime">Crecimiento</span>
                            </h3>
                            <p class="text-gray-400 mb-10 text-xl font-light">
                                Transformamos sus ideas en soluciones tecnológicas robustas de alto impacto.
                            </p>
                        </div>
                        
                        <a
                            href="#contact"
                            class="relative z-10 overflow-hidden bg-lime text-black px-10 py-5 rounded-2xl hover:bg-white transition-all duration-500 text-xl font-black uppercase tracking-tighter text-center group"
                        >
                            <span class="relative z-10">Solicitar Demo</span>
                        </a>
                    </div>
                </div>

                {service.demos && service.demos.length > 0 && (
                    <div class="mt-32">
                        <div class="flex flex-col items-center text-center mb-32 max-w-3xl mx-auto">
                            <h2 class="text-5xl md:text-7xl font-black mb-6 tracking-tighter uppercase">
                                Proyectos <span class="bg-lime text-black px-4 rounded-xl">Reales</span>
                            </h2>
                            <p class="text-2xl text-gray-500 dark:text-gray-400 font-light leading-relaxed">
                                Una mirada profunda a los sistemas que hemos construido para líderes de la industria.
                            </p>
                        </div>

                        <div class="space-y-48">
                            {service.demos.map((demo, demoIndex) => (
                                <div class="relative">
                                    <!-- Company Header -->
                                    <div class="mb-20 border-b border-gray-100 dark:border-gray-800 pb-10">
                                        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                                            <div>
                                                <span class="text-lime font-black uppercase tracking-widest text-sm mb-2 block">Caso de Estudio</span>
                                                <h3 class="text-4xl md:text-6xl font-black tracking-tight">{demo.company}</h3>
                                            </div>
                                            <p class="text-xl text-gray-500 dark:text-gray-400 max-w-md font-light">
                                                {demo.description}
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Demo Items (Individual Features) -->
                                    <div class="space-y-32">
                                        {demo.items.map((item, itemIndex) => (
                                            <div class="group">
                                                <div class="grid lg:grid-cols-12 gap-12 lg:gap-24 items-center">
                                                    <div class={`lg:col-span-12 lg:mb-8`}>
                                                        <div class="flex items-center gap-4">
                                                            <span class="w-12 h-12 rounded-full bg-black text-white dark:bg-white dark:text-black flex items-center justify-center font-black">
                                                                {itemIndex + 1}
                                                            </span>
                                                            <h4 class="text-3xl md:text-4xl font-black tracking-tight group-hover:text-lime transition-colors">
                                                                {item.title}
                                                            </h4>
                                                        </div>
                                                    </div>

                                                    <div class={`lg:col-span-5 ${itemIndex % 2 === 1 ? 'lg:order-2' : ''}`}>
                                                        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed font-light first-letter:text-4xl first-letter:font-black first-letter:mr-2 first-letter:float-left">
                                                            {item.description}
                                                        </p>
                                                        <div class="p-6 rounded-3xl bg-gray-50 dark:bg-gray-800/50 border border-gray-100 dark:border-gray-700">
                                                            <div class="flex items-center gap-3 text-xs font-black uppercase tracking-widest text-gray-400">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                                                                Funcionalidad Implementada
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class={`lg:col-span-7 ${itemIndex % 2 === 1 ? 'lg:order-1' : ''}`}>
                                                        <div class="relative overflow-hidden rounded-[32px] shadow-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-2 transform transition-all duration-700 group-hover:scale-[1.02]">
                                                            <div class="absolute top-4 left-4 flex gap-1.5 z-10">
                                                                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                                                                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                                                                <div class="w-3 h-3 rounded-full bg-green-400"></div>
                                                            </div>
                                                            <Image 
                                                                src={item.image} 
                                                                alt={`${item.title} rendering`}
                                                                class="w-full rounded-[24px] object-cover aspect-[16/10] hover:scale-105 transition-transform duration-1000"
                                                                quality="high"
                                                            />
                                                            <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                )}
            </div>
        </div>
    </Section>

    <style>
        .animate-slow-zoom {
            animation: slow-zoom 20s infinite alternate ease-in-out;
        }
        
        @keyframes slow-zoom {
            from { transform: scale(1.05); }
            to { transform: scale(1.15); }
        }

        .animate-fade-in-up {
            animation: fade-in-up 0.8s forwards cubic-bezier(0.16, 1, 0.3, 1);
            opacity: 0;
            transform: translateY(30px);
        }

        @keyframes fade-in-up {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .mockup-shadow {
            box-shadow: 0 30px 60px -12px rgba(50,50,93,0.25), 0 18px 36px -18px rgba(0,0,0,0.3);
        }

        .glass-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</MainLayout>
