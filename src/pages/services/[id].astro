---
import MainLayout from "../../layouts/MainLayout.astro";
import Section from "../../components/sections/Section.astro";
import { services } from "../../data/services";
import { Image } from "astro:assets";
import Contact from "../../components/sections/Contact.astro";
import Process from "../../components/sections/Process.astro";

export async function getStaticPaths() {
    return services.map((service) => ({
        params: { id: service.id },
        props: { service },
    }));
}

const { id } = Astro.params;
const service = services.find((s) => s.id === id);

if (!service) {
    return Astro.redirect("/404");
}

const { titleTop, titleBottom, description, features, heroImg, alt } = service;
---

<MainLayout
  title={`${titleTop} ${titleBottom} | Miracode Pro`}
  description={description}
>
  <!-- Hero Section Refined -->
  <div class="relative w-full h-[70vh] md:h-[90vh] overflow-hidden bg-dark">
    <div class="absolute inset-0 flex items-center justify-center p-4 md:p-12">
      <div
        id="hero-image-container"
        class="relative w-full h-full max-w-7xl mx-auto rounded-[60px] overflow-hidden opacity-0 translate-y-20 shadow-[0_60px_120px_-20px_rgba(139,92,246,0.3)] border border-white/10"
      >
        <Image
          src={heroImg}
          alt={alt}
          class="w-full h-full object-cover object-top scale-110"
          id="hero-image"
          quality="high"
          loading="eager"
        />
        <!-- Premium Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-dark via-dark/40 to-transparent"></div>
      </div>
    </div>

    <!-- Hero Content Overlay -->
    <div class="absolute inset-0 flex flex-col justify-end p-10 md:p-32 pointer-events-none">
      <div class="max-w-7xl mx-auto w-full">
        <div id="hero-text" class="opacity-0 translate-y-10">
          <span class="inline-block bg-primary text-white px-8 py-2.5 rounded-full text-[10px] font-extrabold uppercase tracking-[0.3em] mb-8 shadow-2xl shadow-primary/40 backdrop-blur-md border border-white/20">
            Desarrollo de Software Elite
          </span>
          <h1 class="text-6xl md:text-[11rem] font-extrabold text-white leading-[0.85] tracking-tighter drop-shadow-2xl mb-4">
            {titleTop}<br />
            <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">{titleBottom}</span>
          </h1>
        </div>
      </div>
    </div>
  </div>

  <Section id="service-detail">
    <div class="py-20 md:py-32">
      <a
        href="/#services"
        class="group inline-flex items-center gap-4 text-gray-500 hover:text-primary dark:text-gray-400 dark:hover:text-primary mb-24 transition-all duration-500"
      >
        <div class="w-12 h-12 rounded-full border border-gray-200 dark:border-gray-800 flex items-center justify-center group-hover:bg-primary group-hover:text-white dark:group-hover:bg-primary dark:group-hover:text-white transition-all shadow-lg group-hover:shadow-primary/30">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
        </div>
        <span class="font-bold uppercase tracking-[0.2em] text-[10px]">Volver a servicios</span>
      </a>

      <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-12 gap-20 mb-32">
          <div class="lg:col-span-8">
            <h2 class="text-xs font-black text-primary uppercase tracking-[0.4em] mb-6">Visión General</h2>
            <p id="desc-text" class="text-2xl md:text-5xl text-dark dark:text-gray-100 leading-[1.1] font-extrabold tracking-tight opacity-0 translate-y-5">
              {description}
            </p>
          </div>
          <div class="lg:col-span-4 flex items-end">
             <div class="w-full h-[1px] bg-gradient-to-r from-primary to-transparent"></div>
          </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-10 mb-40">
          <div
            class="lg:col-span-2 glass-card p-12 md:p-20 rounded-[60px] border border-white/10 bg-white/5 backdrop-blur-3xl relative overflow-hidden shadow-2xl"
          >
            <div class="absolute top-0 right-0 p-12 opacity-5 scale-150 rotate-12">
              <svg width="200" height="200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 2L2 7L12 12L22 7L12 2Z" />
                <path d="M2 17L12 22L22 17" />
                <path d="M2 12L12 17L22 12" />
              </svg>
            </div>
            <h3 class="text-3xl font-extrabold mb-12 flex items-center gap-6">
              <span class="w-1.5 h-12 bg-gradient-to-b from-primary to-secondary rounded-full"></span>
              Capacidades Elite
            </h3>
            <div class="grid md:grid-cols-2 gap-y-10 gap-x-16">
              {
                features.map((feature, i) => (
                  <div class="flex items-start gap-5 group feature-item opacity-0 translate-y-5">
                    <div class="mt-1 bg-primary/10 text-primary rounded-2xl p-3 flex-shrink-0 shadow-xl group-hover:bg-primary group-hover:text-white transition-all duration-300">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </div>
                    <span class="text-xl font-bold text-dark dark:text-gray-100 tracking-tight leading-tight pt-1">
                      {feature}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <div
            class="flex flex-col justify-between p-12 md:p-16 bg-gradient-to-br from-dark to-black text-white rounded-[60px] shadow-2xl relative overflow-hidden group border border-white/5"
          >
            <div class="absolute -top-32 -right-32 w-80 h-80 bg-primary/20 rounded-full blur-[100px] group-hover:bg-primary/40 transition-all duration-1000"></div>
            <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-secondary/10 rounded-full blur-[100px] group-hover:bg-secondary/30 transition-all duration-1000"></div>
            
            <div class="relative z-10">
              <h3 class="text-5xl font-extrabold mb-8 leading-none tracking-tighter">
                Escale su<br /><span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">Potencial</span>
              </h3>
              <p class="text-gray-400 mb-12 text-lg leading-relaxed font-medium">
                Fusionamos ingeniería de vanguardia con diseño disruptivo para crear productos que dominan el mercado.
              </p>
            </div>
            
            <a
              href="/#contact"
              class="relative z-10 overflow-hidden bg-white text-dark px-10 py-6 rounded-3xl hover:bg-primary hover:text-white transition-all duration-500 text-lg font-extrabold uppercase tracking-wider text-center group shadow-xl hover:shadow-primary/30"
            >
              <span class="relative z-10">Solicitar Consultoría</span>
            </a>
          </div>
        </div>

        {service.demos && service.demos.length > 0 && (
          <div class="mt-40">
            <div class="flex flex-col items-center text-center mb-40 max-w-4xl mx-auto">
              <span class="px-6 py-2 bg-secondary/10 text-secondary text-[10px] font-black uppercase tracking-[0.4em] rounded-full border border-secondary/20 mb-10">Casos de Éxito</span>
              <h2 class="text-6xl md:text-9xl font-extrabold mb-10 tracking-tighter leading-none">
                Ecosistemas <br />
                <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">En Producción</span>
              </h2>
              <p class="text-2xl text-gray-500 dark:text-gray-400 font-medium leading-relaxed max-w-2xl">
                Arquitecturas reales desplegadas para resolver desafíos críticos de negocio.
              </p>
            </div>

            <div class="space-y-64">
              {service.demos.map((demo, demoIndex) => (
                <div class="relative demo-block opacity-0 translate-y-20">
                  <!-- Company Header -->
                  <div class="mb-24 border-b border-gray-100 dark:border-gray-800/50 pb-16">
                    <div class="flex flex-col md:flex-row md:items-end justify-between gap-10">
                      <div>
                        <span class="text-secondary font-black uppercase tracking-[0.3em] text-[10px] mb-4 block">Cliente de Elite</span>
                        <h3 class="text-5xl md:text-8xl font-extrabold tracking-tighter text-dark dark:text-white">{demo.company}</h3>
                      </div>
                      <p class="text-xl text-gray-500 dark:text-gray-400 max-w-lg font-medium leading-relaxed">
                        {demo.description}
                      </p>
                    </div>
                  </div>

                  <!-- Demo Items -->
                  <div class="space-y-48">
                    {demo.items.map((item, itemIndex) => (
                      <div class="group item-card">
                        <div class="grid lg:grid-cols-12 gap-16 lg:gap-32 items-center">
                          <div class="lg:col-span-12 lg:mb-12">
                            <div class="flex items-center gap-6">
                              <span class="w-16 h-16 rounded-3xl bg-dark text-white dark:bg-primary dark:text-white flex items-center justify-center font-extrabold text-2xl shadow-2xl">
                                0{itemIndex + 1}
                              </span>
                              <h4 class="text-4xl md:text-6xl font-extrabold tracking-tighter group-hover:text-primary transition-colors duration-500">
                                {item.title}
                              </h4>
                            </div>
                          </div>

                          <div class={`lg:col-span-5 ${itemIndex % 2 === 1 ? 'lg:order-2' : ''}`}>
                            <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 mb-10 leading-relaxed font-medium">
                              {item.description}
                            </p>
                            <div class="inline-flex items-center gap-4 p-6 rounded-[32px] bg-primary/5 dark:bg-primary/10 border border-primary/20">
                              <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                              </div>
                              <span class="text-xs font-black uppercase tracking-widest text-primary">Funcionalidad Implementada</span>
                            </div>
                          </div>
                          
                          <div class={`lg:col-span-7 ${itemIndex % 2 === 1 ? 'lg:order-1' : ''}`}>
                            <div class="relative overflow-hidden rounded-[50px] shadow-[0_50px_100px_-20px_rgba(0,0,0,0.4)] border border-white/10 bg-white dark:bg-dark p-2.5 transform transition-all duration-1000 group-hover:scale-[1.03] group-hover:-rotate-1">
                              <div class="absolute top-6 left-10 flex gap-2 z-10">
                                <div class="w-3.5 h-3.5 rounded-full bg-[#ff5f56]"></div>
                                <div class="w-3.5 h-3.5 rounded-full bg-[#ffbd2e]"></div>
                                <div class="w-3.5 h-3.5 rounded-full bg-[#27c93f]"></div>
                              </div>
                              <Image 
                                src={item.image} 
                                alt={`${item.title} rendering`}
                                class="w-full rounded-[40px] object-cover aspect-[4/3] transition-transform duration-[2s]"
                                quality="high"
                              />
                            </div>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </Section>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);
    
    function initAnimations() {
      // Clear any existing scroll triggers
      ScrollTrigger.getAll().forEach(st => st.kill());
      
      const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
      
      // Reset initial states manually to ensure they are ready for animation
      gsap.set(["#hero-image-container", "#hero-text", "#desc-text", ".feature-item", ".demo-block"], { 
        opacity: 0, 
        y: 20 
      });

      tl.to("#hero-image-container", {
        opacity: 1,
        y: 0,
        duration: 0.8,
      })
      .to("#hero-image", {
        scale: 1,
        duration: 1.2,
      }, "-=0.4")
      .to("#hero-text", {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.1
      }, "-=0.8")
      .to("#desc-text", {
        opacity: 1,
        y: 0,
        duration: 0.6
      }, "-=0.4");

      // Features Animation
      gsap.to(".feature-item", {
        opacity: 1,
        y: 0,
        stagger: 0.05,
        duration: 0.5,
        scrollTrigger: {
          trigger: ".feature-item",
          start: "top 95%"
        }
      });

      // Demo Blocks Animation
      gsap.utils.toArray(".demo-block").forEach((block: any) => {
        gsap.to(block, {
          opacity: 1,
          y: 0,
          duration: 0.8,
          scrollTrigger: {
            trigger: block,
            start: "top 85%",
          }
        });
      });
    }

    // Run on every page load (including View Transitions)
    document.addEventListener('astro:page-load', initAnimations);
  </script>

  <style>
    .glass-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
  </style>
</MainLayout>
