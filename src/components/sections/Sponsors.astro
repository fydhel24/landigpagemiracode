---
import { Image } from "astro:assets";
import s1 from "../../assets/company/logoadmus.webp";
import s2 from "../../assets/company/logoafios.webp";
import s3 from "../../assets/company/logoluigui.webp";
import s4 from "../../assets/company/logoeva.webp";
import s5 from "../../assets/company/logodeseos.webp";
import s6 from "../../assets/company/logo.webp";
import Section from "./Section.astro";
import SectionTitle from "../ui/SectionTitle.astro";

const sponsors = [
  { logo: s6, alt: "Cliente 1" },
  { logo: s5, alt: "Cliente 2" },
  { logo: s4, alt: "Cliente 3" },
  { logo: s3, alt: "Cliente 4" },
  { logo: s2, alt: "Cliente 5" },
  { logo: s1, alt: "Cliente 6" },
];
---

<Section id="sponsors">
  <div id="sponsors-title">
    <SectionTitle
      sectionTitle="Nuestros Clientes"
      description="Empresas que confían en nuestras soluciones tecnológicas"
    />
  </div>
  <div class="flex-row items-center">
    <div
      class="flex flex-wrap justify-center gap-6 md:gap-8"
      id="sponsors-grid"
    >
      {
        sponsors.map((sponsor) => {
          return (
            <div class="sponsor-logo group relative p-6 bg-white/5 dark:bg-white/5 backdrop-blur-sm border border-white/10 dark:border-white/5 rounded-2xl shadow-lg transition-all duration-300 hover:scale-110 hover:bg-white/10 hover:border-primary/30">
              <Image
                src={sponsor.logo}
                class="h-8 md:h-10 w-auto mx-auto grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300"
                alt={sponsor.alt}
                loading="lazy"
              />
            </div>
          );
        })
      }
    </div>
  </div>
</Section>

<script>
  import { gsap } from "gsap";

  // Animate sponsors section
  gsap.set("#sponsors-title", { opacity: 0, y: 50 });
  gsap.set(".sponsor-logo", { opacity: 0, scale: 0.8 });

  gsap.to("#sponsors-title", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power2.out",
  });

  gsap.to(".sponsor-logo", {
    opacity: 1,
    scale: 1,
    duration: 0.6,
    ease: "back.out(1.7)",
    stagger: 0.1,
    delay: 0.5,
  });
</script>
