---
import { Image } from "astro:assets";
import linkd from "../../assets/pics/profile-in.svg";
import Card from "./Card.astro";

const { pic, name, role, description, link } = Astro.props;
---

<Card isUnderline={false}>
  <div
    class="p-8 md:p-12 bg-white dark:bg-white/5 backdrop-blur-md rounded-[60px] border border-white/10 shadow-xl transition-all duration-300 hover:shadow-primary/10"
  >
    <div
      class="flex flex-col sm:flex-row items-center gap-6 relative"
      id="team-header"
    >
      <div class="relative group" id="team-image">
        <!-- Deco Blob -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-primary to-secondary rounded-full blur-xl opacity-20 group-hover:opacity-40 transition-opacity duration-500"
        >
        </div>
        <div
          class="relative w-32 h-32 md:w-40 md:h-40 overflow-hidden rounded-full border-4 border-white dark:border-dark shadow-lg"
        >
          <Image src={pic} alt={name} class="w-full h-full object-cover" />
        </div>
      </div>

      <div
        class="flex flex-col justify-center text-center sm:text-left"
        id="team-info"
      >
        <h3
          class="text-xl md:text-2xl font-extrabold text-dark dark:text-white leading-tight"
        >
          {name}
        </h3>
        <p
          class="text-primary font-bold uppercase tracking-wider text-xs md:text-sm mt-1"
        >
          {role}
        </p>
      </div>
    </div>

    <div
      class="w-20 h-1.5 bg-gradient-to-r from-primary to-secondary rounded-full my-8 mx-auto sm:mx-0"
      id="team-separator"
    >
    </div>

    <div
      class="text-gray-600 dark:text-gray-300 text-sm md:text-base leading-relaxed font-medium"
      id="team-description"
    >
      {description}
    </div>
  </div>
</Card>

<script>
  import { gsap } from "gsap";

  // Animate team card on load
  gsap.set("#team-card", { opacity: 0, y: 30 });
  gsap.to("#team-card", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power2.out",
  });
</script>
