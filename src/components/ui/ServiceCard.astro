---
import { Image } from "astro:assets";
import Card from "./Card.astro";

const { index, titleTop, titleBottom, img, alt, link } = Astro.props;

const bgImage = typeof img === "string" ? img : img.src;
---

<Card isUnderline={false}>
  <a
    href={link}
    class="group block relative h-[420px] w-full overflow-hidden rounded-[80px] transition-all duration-500 hover:shadow-2xl hover:shadow-primary/20 border border-white/10"
  >
    <!-- Background Image with Zoom Effect -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-110"
      style={`background-image: url(${JSON.stringify(bgImage)})`}
    >
    </div>

    <!-- Dark Gradient Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent transition-opacity duration-500 group-hover:opacity-100"
    >
    </div>

    <!-- Content Context -->
    <div class="absolute inset-0 p-8 flex flex-col justify-between">
      <!-- Index Badge -->
      <div
        class="w-10 h-10 rounded-full bg-primary/20 backdrop-blur-md border border-primary/30 flex items-center justify-center text-primary font-extrabold text-sm"
      >
        0{index}
      </div>

      <div
        class="transform transition-all duration-500 translate-y-2 group-hover:translate-y-0"
      >
        <h3
          class="text-2xl font-extrabold text-white leading-tight mb-4 group-hover:text-primary transition-colors"
        >
          <span class="text-secondary">{titleTop}</span><br />
          {titleBottom}
        </h3>

        <div
          class="flex items-center gap-2 text-white font-bold uppercase tracking-widest text-[10px] opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100"
        >
          <div
            class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </div>
          Ver más
        </div>
      </div>
    </div>
  </a>
</Card>

<style>
  .custom-grid {
    grid-template: auto auto;
  }
</style>
