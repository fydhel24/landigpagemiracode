---
const { sectionTitle, description } = Astro.props;
---

<div class="flex flex-col items-center gap-6 mb-10">
  <!-- Caja blanca a lo ancho de la pantalla -->
  <div class="w-full flex justify-center">
    <div class="w-full bg-white py-4 flex items-center justify-center relative">
      <!-- Línea izquierda -->
      <div class="h-[3px] bg-gradient-to-r from-transparent to-primary flex-1">
      </div>

      <!-- Texto centrado -->
      <span
        class="text-primary dark:text-white text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl px-2 sm:px-4 font-bold break-words text-center uppercase tracking-tight"
      >
        {sectionTitle}
      </span>

      <!-- Línea derecha -->
      <div class="h-[3px] bg-gradient-to-l from-transparent to-primary flex-1">
      </div>
    </div>
  </div>
</div>
