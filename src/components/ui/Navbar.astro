---
import { Astronav } from "astro-navbar";

const menuitems = [
  { href: "/", label: "Inicio" },
  { href: "/about", label: "Sobre nosotros" },
  { href: "/services", label: "Servicios" },
  { href: "/pricing", label: "Precios" },
  { href: "/articles", label: "Blog" },
  { href: "/demos", label: "Demos" },
];

const navButton = { href: "/#contact", label: "Contáctanos" };
---

<style>
  /* Subrayado animado con degradado (Miracode Style) */
  .nav-underline {
    position: relative;
    display: inline-block;
  }

  .nav-underline::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 0px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #06b6d4);
    transition: width 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .nav-underline:hover::after {
    width: 100%;
  }

  /* Estado inicial del navbar */
  nav.navbar-transparent {
    background-color: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  /* Efecto Glass al hacer scroll */
  nav.navbar-scrolled {
    @apply bg-white/70 dark:bg-brand-bg/60 backdrop-blur-lg border-b border-brand-border/30 shadow-lg transition-all duration-500;
  }
</style>

<div >
  <!-- Spacer for fixed navbar -->
  <nav
    id="main-navbar"
    class="w-full top-0 left-0 z-50 fixed transition-all duration-500 navbar-transparent"
  >
    <header
      class="flex flex-col lg:flex-row justify-between items-center py-4 px-6 md:px-12 max-w-7xl mx-auto"
    >
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <a
            href="/"
            class="flex items-center space-x-3 rtl:space-x-reverse group"
          >
            <img
              src="/logomiracode.webp"
              class="h-14 w-auto transition-transform duration-300 group-hover:scale-110"
              alt="Logo"
            />
          </a>
          <div class="block lg:hidden">
            <div
              id="menu-icon"
              class="w-8 h-8 flex items-center justify-center rounded-full bg-brand-surface/50 text-brand-text cursor-pointer transition-all duration-300 hover:bg-brand-accent hover:text-white"
            >
              <!-- Open (hamburger) icon -->
              <svg
                id="open-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="w-6 h-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
              <!-- Close (X) icon -->
              <svg
                id="close-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="w-6 h-6 hidden"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </div>
          </div>
        </div>

        <nav
          class="hidden w-full lg:w-auto mt-4 lg:flex lg:mt-0"
          id="menu-items"
        >
          <ul
            class="font-semibold flex flex-col p-6 lg:p-0 mt-4 border border-brand-border/20 rounded-2xl bg-white/90 dark:bg-brand-bg/90 backdrop-blur-xl lg:bg-transparent lg:dark:bg-transparent lg:flex-row lg:space-x-8 lg:mt-0 lg:border-0 shadow-2xl lg:shadow-none"
          >
            {
              menuitems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="nav-underline mobile-nav-link block py-2 text-sm text-brand-text/80 hover:text-brand-accent transition-colors duration-200"
                    data-close-menu="true"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }

            <div
              class="lg:hidden flex flex-col items-center justify-center mt-6 gap-4 pb-2 border-t border-brand-border/20 pt-6"
            >
              <!-- Mobile theme toggle -->
              <button
                id="theme-toggle-mobile"
                class="flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-surface text-brand-text hover:bg-brand-accent hover:text-white transition-all duration-300 text-sm font-bold"
              >
                <span id="theme-text-mobile">Cambiar Tema</span>
                <!-- Sol -->
                <svg
                  id="sun-icon-mobile"
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364l-1.414 1.414M6.05 17.95l-1.414 1.414M17.95 17.95l-1.414-1.414M6.05 6.05L4.636 7.464M12 8a4 4 0 100 8 4 4 0 000-8z"
                  ></path>
                </svg>
                <!-- Luna -->
                <svg
                  id="moon-icon-mobile"
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 hidden"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"></path>
                </svg>
              </button>

              <a
                class="btn-primary py-3 w-full text-center text-sm"
                href={navButton.href}
                data-close-menu="true"
              >
                {navButton.label}
              </a>
            </div>
          </ul>
        </nav>
      </Astronav>

      <div class="hidden lg:flex items-center gap-6">
        <!-- Desktop theme toggle -->
        <button
          id="theme-toggle"
          class="p-2.5 rounded-xl bg-brand-surface/50 hover:bg-brand-accent hover:text-white text-brand-text transition-all duration-300"
          aria-label="Cambiar tema"
        >
          <!-- Sol -->
          <svg
            id="sun-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364l-1.414 1.414M6.05 17.95l-1.414 1.414M17.95 17.95l-1.414-1.414M6.05 6.05L4.636 7.464M12 8a4 4 0 100 8 4 4 0 000-8z"
            ></path>
          </svg>
          <!-- Luna -->
          <svg
            id="moon-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"></path>
          </svg>
        </button>

        <a class="btn-primary py-2.5 text-sm" href={navButton.href}>
          {navButton.label}
        </a>
      </div>
    </header>
  </nav>
</div>

<script is:inline>
  function initNavbar() {
    const navbar = document.getElementById("main-navbar");
    const menuIcon = document.getElementById("menu-icon");
    const openIcon = document.getElementById("open-icon");
    const closeIcon = document.getElementById("close-icon");
    const menuItems = document.getElementById("menu-items");
    const closeMenuItems = document.querySelectorAll(
      '[data-close-menu="true"]',
    );

    // Scroll Logic
    const handleScroll = () => {
      if (window.scrollY > 20) {
        navbar?.classList.add("navbar-scrolled");
        navbar?.classList.remove("navbar-transparent");
      } else {
        navbar?.classList.remove("navbar-scrolled");
        navbar?.classList.add("navbar-transparent");
      }
    };

    window.addEventListener("scroll", handleScroll);
    handleScroll(); // Initial check

    // Menu Toggle
    const toggleMenu = () => {
      menuItems?.classList.toggle("hidden");
      openIcon?.classList.toggle("hidden");
      closeIcon?.classList.toggle("hidden");
    };

    if (menuIcon) {
      // Use a flag to avoid multiple listeners if re-initialized
      if (!menuIcon.dataset.listener) {
        menuIcon.addEventListener("click", toggleMenu);
        menuIcon.dataset.listener = "true";
      }
    }

    closeMenuItems.forEach((item) => {
      if (!item.dataset.listener) {
        item.addEventListener("click", () => {
          menuItems?.classList.add("hidden");
          openIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
        });
        item.dataset.listener = "true";
      }
    });

    // Theme toggle
    const themeToggle = document.getElementById("theme-toggle");
    const themeToggleMobile = document.getElementById("theme-toggle-mobile");

    const sunIcon = document.getElementById("sun-icon");
    const moonIcon = document.getElementById("moon-icon");
    const sunIconMobile = document.getElementById("sun-icon-mobile");
    const moonIconMobile = document.getElementById("moon-icon-mobile");

    const updateIcons = (isDark) => {
      if (isDark) {
        sunIcon?.classList.add("hidden");
        moonIcon?.classList.remove("hidden");
        sunIconMobile?.classList.add("hidden");
        moonIconMobile?.classList.remove("hidden");
      } else {
        sunIcon?.classList.remove("hidden");
        moonIcon?.classList.add("hidden");
        sunIconMobile?.classList.remove("hidden");
        moonIconMobile?.classList.add("hidden");
      }
    };

    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateIcons(isDark);
    };

    if (themeToggle && !themeToggle.dataset.listener) {
      themeToggle.addEventListener("click", toggleTheme);
      themeToggle.dataset.listener = "true";
    }

    if (themeToggleMobile && !themeToggleMobile.dataset.listener) {
      themeToggleMobile.addEventListener("click", toggleTheme);
      themeToggleMobile.dataset.listener = "true";
    }

    // Initial icon state
    updateIcons(document.documentElement.classList.contains("dark"));
  }

  // Run on initial load
  initNavbar();

  // Run on view transitions navigation
  document.addEventListener("astro:page-load", initNavbar);
</script>
