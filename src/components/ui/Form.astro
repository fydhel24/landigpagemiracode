---
import { Image } from "astro:assets";
import decorForm from "../../assets/pics/logo4.png";
---

<div
  class="relative bg-white dark:bg-dark/40 backdrop-blur-md rounded-[40px] border border-gray-200/50 dark:border-gray-800/50 overflow-hidden flex flex-col lg:flex-row shadow-2xl"
>
  <!-- Formulario -->
  <form
    action="https://formspree.io/f/TU_FORM_ID"
    method="POST"
    class="bg-white/50 dark:bg-dark/20 p-8 md:p-12 max-w-lg w-full flex-shrink-0"
  >
    <div class="flex flex-col sm:flex-row gap-6 mb-8">
      <div class="flex items-center gap-3">
        <input
          type="radio"
          id="inquiry"
          name="type"
          value="consulta"
          class="radio-tech"
          checked
        />
        <label
          for="inquiry"
          class="text-gray-800 dark:text-gray-100 font-bold text-sm uppercase tracking-wide cursor-pointer"
          >Consulta técnica</label
        >
      </div>
      <div class="flex items-center gap-3">
        <input
          type="radio"
          id="quote"
          name="type"
          value="cotizacion"
          class="radio-tech"
        />
        <label
          for="quote"
          class="text-gray-800 dark:text-gray-100 font-bold text-sm uppercase tracking-wide cursor-pointer"
          >Cotización</label
        >
      </div>
    </div>

    <div class="mb-6">
      <label
        for="name"
        class="block text-gray-700 dark:text-gray-300 mb-2 font-bold text-sm"
        >Nombre Completo</label
      >
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder="Ej. Ronald Gutierrez"
        class="w-full px-5 py-4 border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/50 text-gray-900 dark:text-white rounded-2xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all duration-300 placeholder-gray-400 dark:placeholder-gray-500 shadow-sm"
      />
    </div>

    <div class="mb-6">
      <label
        for="email"
        class="block text-gray-700 dark:text-gray-300 mb-2 font-bold text-sm"
        >Correo Electrónico</label
      >
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="tu@email.com"
        class="w-full px-5 py-4 border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/50 text-gray-900 dark:text-white rounded-2xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all duration-300 placeholder-gray-400 dark:placeholder-gray-500 shadow-sm"
      />
    </div>

    <div class="mb-8">
      <label
        for="message"
        class="block text-gray-700 dark:text-gray-300 mb-2 font-bold text-sm"
        >¿En qué podemos ayudarte?</label
      >
      <textarea
        id="message"
        name="message"
        required
        placeholder="Cuéntanos tu idea o desafío tecnológico..."
        rows="4"
        class="w-full px-5 py-4 border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/50 text-gray-900 dark:text-white rounded-2xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all duration-300 placeholder-gray-400 dark:placeholder-gray-500 shadow-sm"
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full bg-gradient-to-r from-primary to-secondary hover:from-secondary hover:to-primary text-white font-extrabold py-4 px-8 rounded-2xl transition-all duration-500 shadow-lg shadow-primary/20 hover:shadow-secondary/30 transform hover:-translate-y-1"
    >
      Enviar Mensaje
    </button>
  </form>

  <!-- Ilustración decorativa -->
  <div
    class="hidden lg:flex items-center justify-center bg-gray-50/50 dark:bg-black/20 w-full p-12"
  >
    <div class="relative w-full h-full flex items-center justify-center">
      <div
        class="absolute w-64 h-64 bg-primary/10 rounded-full blur-3xl animate-pulse"
      >
      </div>
      <Image
        src={decorForm}
        alt="Ilustración decorativa"
        class="relative h-auto w-4/5 object-contain opacity-90 drop-shadow-2xl"
      />
    </div>
  </div>
</div>

<style>
  .radio-tech {
    appearance: none;
    width: 22px;
    height: 22px;
    border: 2px solid var(--primary);
    border-radius: 50%;
    outline: none;
    cursor: pointer;
    position: relative;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .radio-tech:checked {
    background-color: var(--primary);
    border-color: var(--primary);
    box-shadow: 0 0 10px rgba(139, 92, 246, 0.4);
  }

  .radio-tech:checked::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    background: white;
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(1);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
</style>

<script>
  function setupForm() {
    const quoteRadio = document.getElementById("quote") as HTMLInputElement;
    const inquiryRadio = document.getElementById("inquiry") as HTMLInputElement;
    const messageField = document.getElementById(
      "message",
    ) as HTMLTextAreaElement;

    if (!quoteRadio || !inquiryRadio || !messageField) return;

    quoteRadio.addEventListener("change", () => {
      if (quoteRadio.checked) {
        messageField.value =
          "Hola Miracode, nos gustaría solicitar una cotización para un proyecto de...";
      }
    });

    inquiryRadio.addEventListener("change", () => {
      if (inquiryRadio.checked) {
        messageField.value = "";
      }
    });
  }

  setupForm();
  document.addEventListener("astro:after-swap", setupForm);
</script>
