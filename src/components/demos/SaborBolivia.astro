---
/* SaborBolivia.astro */
---

<style>
  @import url('https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300;400;500;600;700&display=swap');

  .sabor-bolivia-root {
    font-family: 'Spline Sans', sans-serif;
    --primary: #36e27b;
    --background-dark: #112117;
    --surface-dark: #1A2C22;
  }

  /* Replicamos las clases de Tailwind que eran custom */
  .bg-primary { background-color: var(--primary); }
  .text-primary { color: var(--primary); }
  .bg-background-dark { background-color: var(--background-dark); }
  .bg-surface-dark { background-color: var(--surface-dark); }
</style>

<div class="sabor-bolivia-root bg-background-light dark:bg-background-dark text-slate-900 dark:text-white antialiased overflow-x-hidden">
  <nav class="sticky top-0 z-50 w-full border-b border-[#29382f] bg-[#112117]/90 backdrop-blur-md">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-[#112117]">
            <span class="material-symbols-outlined" style="font-size: 20px;">restaurant</span>
          </div>
          <h2 class="text-white text-lg font-bold tracking-tight">Sabor de Bolivia</h2>
        </div>
        <div class="hidden md:flex flex-1 justify-center gap-8">
          <a class="text-white hover:text-primary transition-colors text-sm font-medium" href="#menu">Menu</a>
          <a class="text-white hover:text-primary transition-colors text-sm font-medium" href="#story">Story</a>
          <a class="text-white hover:text-primary transition-colors text-sm font-medium" href="#location">Location</a>
        </div>
        <div class="flex items-center gap-3">
          <button aria-label="Order Delivery" class="flex items-center justify-center h-10 w-10 rounded-full bg-[#29382f] text-white hover:bg-[#3a4f42] transition-colors">
            <span class="material-symbols-outlined" style="font-size: 20px;">two_wheeler</span>
          </button>
          <button class="hidden sm:flex h-10 items-center justify-center rounded-full bg-primary px-6 text-[#111714] text-sm font-bold tracking-wide hover:bg-[#2cd06e] transition-colors">
            RESERVE TABLE
          </button>
        </div>
      </div>
    </div>
  </nav>

  <main class="flex flex-col w-full">
    <section class="relative w-full">
      <div class="px-4 py-6 md:px-10 md:py-8 lg:px-40">
        <div class="relative flex min-h-[560px] flex-col gap-6 overflow-hidden rounded-xl bg-cover bg-center bg-no-repeat p-8 items-center justify-center text-center shadow-2xl" 
             style='background-image: linear-gradient(rgba(17, 33, 23, 0.4), rgba(17, 33, 23, 0.7)), url("https://images.unsplash.com/photo-1633504581786-316c8002b1b9?q=80&w=2070&auto=format&fit=crop");'>
          <div class="flex flex-col gap-4 max-w-3xl">
            <span class="text-primary font-bold tracking-wider text-sm uppercase">Welcome to La Paz</span>
            <h1 class="text-white text-5xl md:text-6xl lg:text-7xl font-black leading-tight tracking-tight drop-shadow-lg">
              Authentic Flavors <br/> of the Andes
            </h1>
            <h2 class="text-gray-200 text-lg md:text-xl font-normal max-w-2xl mx-auto drop-shadow-md">
              Experience the heart of Bolivia on your plate. From the Altiplano to the Amazon.
            </h2>
          </div>
          <div class="mt-4 flex flex-col sm:flex-row gap-4">
            <button class="h-12 px-8 rounded-full bg-primary text-[#111714] text-base font-bold tracking-wide hover:scale-105 transition-transform shadow-lg shadow-primary/20">
              RESERVE TABLE
            </button>
            <button class="h-12 px-8 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white text-base font-bold tracking-wide hover:bg-white/20 transition-colors">
              VIEW MENU
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 md:py-16" id="menu">
      <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-2 mb-8 text-center sm:text-left">
          <h2 class="text-white text-3xl font-bold tracking-tight">Our Menu</h2>
          <p class="text-gray-400">Explore the diversity of Bolivian cuisine.</p>
        </div>
        <div class="flex w-full overflow-x-auto pb-6 gap-6 sm:gap-10">
           <div class="group flex flex-col items-center gap-4 min-w-[100px]">
              <div class="w-24 h-24 rounded-full bg-slate-800 border-2 border-transparent group-hover:border-primary transition-all"></div>
              <p class="text-white text-sm font-medium">Traditional</p>
           </div>
           </div>
      </div>
    </section>

    </main>
</div>